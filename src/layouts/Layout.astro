---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Overrides the default social-share card for a given page. */
  image?: string;
}

const { title, description, image } = Astro.props;

// Google Analytics 4 - only emitted in production builds
const GA_ID = 'G-F96KB6L8G6';

// Google Search Console ownership proof. Paste the token from the
// "HTML tag" verification method here (the content="..." value only).
// Leave empty to emit nothing — note that GSC can also verify via the GA4
// property above, which needs no token at all.
const GOOGLE_SITE_VERIFICATION = '';
const enableAnalytics = import.meta.env.PROD;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

// Absolute URLs for canonical + social cards. Astro.url.pathname already carries
// the configured `base`, so this stays correct if the site ever moves to a domain root.
const siteUrl = Astro.site ?? new URL('https://darkify19.github.io');
// Normalize the trailing slash ourselves: Astro versions differ on whether
// `pathname` keeps it, and canonical must match the sitemap byte for byte.
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonical = new URL(pathname, siteUrl).href;
const ogImage = new URL(image ?? `${base}og.png`, siteUrl).href;
const cvUrl = new URL(`${base}OropesaCarlJanzell-CV.pdf`, siteUrl).href;

const linkedin = 'https://www.linkedin.com/in/carl-janzell-764399179/';
const github = 'https://github.com/carljanzell';

// Person schema so a search for the name resolves to this page rather than to
// scattered profiles. Only facts already stated on the page.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': canonical + '#person',
  name: 'Carl Janzell Oropesa',
  alternateName: 'Carl Oropesa',
  url: canonical,
  image: ogImage,
  email: 'mailto:carl.oropesa11@gmail.com',
  jobTitle: 'Full-Stack Software Engineer',
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Los Baños',
    addressRegion: 'Laguna',
    addressCountry: 'PH',
  },
  worksFor: {
    '@type': 'CollegeOrUniversity',
    name: 'University of the Philippines Los Baños',
    url: 'https://uplb.edu.ph/',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Laguna State Polytechnic University — Los Baños',
  },
  knowsAbout: [
    'PHP',
    'Laravel',
    'Filament',
    'Livewire',
    'Ruby on Rails',
    'Apache Kafka',
    'Event-driven architecture',
    'Vue.js',
    'Tailwind CSS',
    'MySQL',
    'PostgreSQL',
    'CI/CD',
    'AI-assisted software development',
  ],
  sameAs: [linkedin, github, 'https://github.com/Darkify19'],
};

// The public repos, declared as code so search engines can attach them to the
// person above rather than treating them as loose outbound links.
const repoSchemas = [
  {
    name: 'samyang-back',
    description:
      'GraphQL API for a dating app — Ruby on Rails 8 and PostgreSQL, with swipe/match, messaging and photo management.',
    repo: 'https://github.com/Darkify19/samyang-back',
    languages: ['Ruby', 'GraphQL', 'SQL'],
    runtime: 'Ruby on Rails 8',
  },
  {
    name: 'samyang-front',
    description:
      'Vue 2 and Vuex single-page client for a dating app, talking to a Rails GraphQL API through Apollo Client.',
    repo: 'https://github.com/Darkify19/samyang-front',
    languages: ['JavaScript'],
    runtime: 'Vue 2',
  },
  {
    name: 'filament-page-builder',
    description:
      'Drag-and-drop visual page builder for Filament — nested layout canvas, document outline, token style inspector and undo/redo.',
    repo: 'https://github.com/carljanzell/filament-page-builder',
    languages: ['PHP', 'JavaScript'],
    runtime: 'Laravel / Filament',
  },
].map((r) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: r.name,
  description: r.description,
  codeRepository: r.repo,
  url: r.repo,
  programmingLanguage: r.languages,
  runtimePlatform: r.runtime,
  author: { '@id': canonical + '#person' },
  isAccessibleForFree: true,
}));

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'en',
  mainEntity: { '@id': canonical + '#person' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      GOOGLE_SITE_VERIFICATION && (
        <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
      )
    }
    <meta name="author" content="Carl Janzell Oropesa" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <link rel="alternate" type="application/pdf" title="Resume (PDF)" href={cvUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Carl Janzell Oropesa" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Carl Janzell Oropesa — full-stack software engineer building Laravel systems for 4,000+ university personnel"
    />
    <meta property="profile:first_name" content="Carl Janzell" />
    <meta property="profile:last_name" content="Oropesa" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#121519" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;500;600;700&family=Martian+Mono:wdth,wght@75..100,400..500&display=swap"
      rel="stylesheet"
    />

    <!--
      Motion gate. Runs before first paint so the punch-in and the heatmap
      ripple can start from hidden without a flash. If the page scripts never
      report in (blocked, failed), everything is shown after 2.5 s.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion');
        if (!location.hash) {
          root.classList.add('punch');
          window.__punchUntil = performance.now() + 2100;
        }
        setTimeout(function () {
          if (!window.__motion) root.classList.remove('motion', 'punch');
        }, 2500);
      })();
    </script>

    {
      enableAnalytics && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
          />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || []; window.gtag = function
            gtag() { window.dataLayer.push(arguments); }; gtag('js', new
            Date()); gtag('config', GA_ID);
          </script>
        </>
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(profilePageSchema)}
    />
    {
      repoSchemas.map((repo) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(repo)} />
      ))
    }
  </head>
  <body>
    <slot />
  </body>
</html>
