<script>
  // First load, once: the identity and fact labels type in, the rules draw,
  // the figures count up, and one stamp lands. About two seconds.
  const w = window as any;
  w.__motion = true;

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  const INOUT = 'cubic-bezier(0.45, 0, 0.55, 1)';
  const OUT = 'cubic-bezier(0.22, 1, 0.36, 1)';

  function typeIn(el: HTMLElement, at: number, perChar: number) {
    const text = el.textContent ?? '';
    el.textContent = '';
    const chars = [...text].map((ch, i) => {
      const s = document.createElement('span');
      s.textContent = ch;
      el.appendChild(s);
      s.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 1, delay: at + i * perChar, fill: 'backwards' });
      return s;
    });
    // hand the plain text back once typed, so nothing reads it letter by letter
    setTimeout(() => {
      el.textContent = text;
    }, at + chars.length * perChar + 50);
  }

  function countUp(el: HTMLElement, at: number, duration: number) {
    const final = el.textContent ?? '';
    const target = Number(final.replace(/\D/g, ''));
    if (!target) return;
    el.textContent = '0';
    const t0 = performance.now() + at;
    const tick = (now: number) => {
      const t = Math.min(1, Math.max(0, (now - t0) / duration));
      // ease-out expo
      const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
      el.textContent = t === 1 ? final : Math.round(target * eased).toLocaleString('en-US');
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function punchIn(scope: HTMLElement) {
    const q = (sel: string) => [...document.querySelectorAll<HTMLElement>(sel)];

    q('.topbar [data-punch="type"]').forEach((el, k) => typeIn(el, k * 160, 18));

    scope.querySelectorAll<HTMLElement>('[data-punch="rule"]').forEach((el, i) => {
      el.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
        duration: 460,
        delay: i * 110,
        easing: INOUT,
        fill: 'backwards',
      });
    });
    scope.querySelectorAll<HTMLElement>('.fact [data-punch="type"]').forEach((el, k) => typeIn(el, 380 + k * 160, 12));
    scope.querySelectorAll<HTMLElement>('[data-punch="count"]').forEach((el) => countUp(el, 400, 1400));

    scope.querySelector<HTMLElement>('[data-punch="stamp"]')?.animate(
      [
        { transform: 'scale(2.1)', opacity: 0 },
        { transform: 'scale(1)', opacity: 1 },
      ],
      { duration: 380, delay: 1500, easing: OUT, fill: 'backwards' },
    );
    // the stamp's weight lands on the facts
    scope.querySelector<HTMLElement>('[data-facts]')?.animate(
      [{ transform: 'translateY(0)' }, { transform: 'translateY(1.5px)', offset: 0.25 }, { transform: 'translateY(0)' }],
      { duration: 210, delay: 1840 },
    );
  }

  if (root.classList.contains('punch')) {
    try {
      // arriving mid-page (restored scroll) means nobody would see it
      if (hero && window.scrollY < hero.offsetHeight / 2) punchIn(hero);
      else w.__punchUntil = 0;
    } catch {
      w.__punchUntil = 0;
    } finally {
      // the animations now hold their own starting states
      root.classList.remove('punch');
    }
  }
</script>
