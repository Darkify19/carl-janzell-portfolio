---
import Layout from '../layouts/Layout.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import ContributionHeatmap from '../components/ContributionHeatmap.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const cvHref = `${base}OropesaCarlJanzell-CV.pdf`;
const linkedin = 'https://www.linkedin.com/in/carl-janzell-764399179/';
const github = 'https://github.com/carljanzell';
const email = 'carl.oropesa11@gmail.com';

// Hero figures. Deploys re-derived from `deploy-*` git tags across every repo with
// real authorship (npm run stats); usage from UPLB-TKS's own Usage Analytics page.
// Each one carries its window. Windowed; never extrapolated.
const facts = [
  { value: '795', label: 'tagged production deploys, to 22\u00a0Sep\u00a02026' },
  { value: '224,490', label: 'attendance punches, 180 days to 22\u00a0Sep\u00a02026' },
  { value: '238', label: 'concurrent users at the 8\u00a0AM rush, 22\u00a0Sep\u00a02026' },
];

interface Project {
  id: string;
  name: string;
  kind: string;
  role: string;
  desc: string;
  spec?: [string, string][];
  highlights: string[];
  stack: string[];
}

const projects: Project[] = [
  {
    id: 'tks',
    name: 'UPLB-TKS',
    kind: 'Timekeeping system',
    role: 'lead developer · primary author',
    desc: "Daily time records, leave, performance reviews, certificates of service, travel requests and schedules for 4,000+ UP Los Baños personnel, served through two Filament panels: HR admin and employee self-service. It replaced the university's paper processes, and the rest of the ecosystem is built around it.",
    // Real production figures from the system's own Usage Analytics page.
    spec: [
      ['serves', '4,000+ UP Los Baños personnel. 1,486 timed in within the 30 days to 22 Sep 2026, and 567 on an average working day.'],
      ['replaced', 'paper daily time records, leave forms and certificates of service'],
      ['captured', '224,490 attendance punches over the 180 days to 22 Sep 2026: 79.9% directly (web 59.7%, kiosk 20.1%) and 20.1% keyed in by hand. Direct capture is rising: 96.1% over the trailing 7 days.'],
      ['traffic', '183,765 page views and 10,369 logins over the 44 days to 22 Sep 2026; 876 unique users on an average working day, and 238 concurrent at the 8 AM clock-in rush on 22 Sep.'],
      ['shipped', "431 tagged production deploys to 22 Sep 2026, each release with a “What's New” page written for personnel"],
    ],
    highlights: [
      'DTR engine: flexible periods, biometric and manual attendance merged, grace-period undertime, IP-based clock-in validation.',
      'Leave management that is the canonical balance source for the whole ecosystem; the HR system of record reads it over REST.',
      "Scheduling shaped by how the university actually works: split shifts with a configurable break end, a request-and-approve flow for assignments and new shifts, schedules suggested from a person's own attendance history, and whole-roster fit triage in one pass.",
      'A reusable approval-workflow state machine (draft to approved) with per-transition audit logging, later extracted into its own app.',
      'Kafka consumers with data-contract enforcement, and RBAC across 30+ models with office-scoped, self-only and unscoped role tiers.',
      'Identity and context: one-time-token SSO from the UPLB Portal, Google One Tap locked to the up.edu.ph domain, and a read-only Calendar sync that tags where someone is working. VPN-aware punch-origin classification puts work-from-home markers straight onto the DTR.',
      "Guest mode: a fabricated tenant, so the system can be demoed to a room without projecting a real employee's name, birthdate or leave balance. Office scope is pinned to an empty override (10 visible personnel out of 5,089), Kafka is muted for the session so invented people never reach the live bus, writes are denied on anything scoping can't confine, and it's off by default.",
      "A real release pipeline: AI-drafted, human-reviewed changelogs feed the personnel-facing “What's New” page, covered by unit and feature tests.",
      "A small opt-out break-room mini-game on the dashboard, deliberately never joined to attendance data so play can't be read as evaluation.",
    ],
    stack: ['PHP 8.2', 'Laravel 11', 'Filament 3', 'Livewire 3', 'MySQL', 'Apache Kafka', 'Tailwind CSS', 'DomPDF', 'PHPUnit 11', 'GitHub Actions'],
  },
  {
    id: 'pmt',
    name: 'PerporManTask',
    kind: 'Performance management',
    role: 'sole author',
    desc: 'A performance-management service (IPCR) carved out of the timekeeping monolith into its own app on purpose, sharing data over Kafka: a modularization decision made on a live system.',
    highlights: [
      'IPCR module: semestral rating periods, weighted target distribution validated to 100%, and UP SPMS-compliant landscape PDFs.',
      'Production AI feature: task logs are exported as structured bundles, an LLM clusters them, and a tolerant JSON import transactionally builds draft reviews. Human in the loop by design.',
      'Cross-app import with stable identity resolution (uuid, then email, then employee number) and a dry-run preview built on rolled-back transactions.',
    ],
    stack: ['Laravel 12', 'Filament 5', 'Kafka', 'MySQL', 'Tailwind CSS 4', 'PHPUnit 11'],
  },
  {
    id: 'kiosk',
    name: 'UPLB Kiosk',
    kind: 'Offline-first attendance terminal',
    role: 'lead developer · primary author',
    desc: "Shared walk-up terminals for personnel who don't sit at a desk, writing punches straight into the TKS database. The kiosks carried 20.1% of every punch in the 180 days to 22 Sep 2026, and over 1,200 a day by late September. They're offline-first because a building's network is not a given, and every punch a kiosk fails to take is one a timekeeper has to key in later.",
    highlights: [
      "Offline-first punching: a dropped network doesn't drop the punch. Attendance is stored locally and replayed through a sync endpoint, and the screen says plainly that the punch is saved either way.",
      'Machine identity that survives a cleared browser: a device token issued once and mirrored across cookie and localStorage, so one physical kiosk stays one row instead of spawning a new device every session.',
      "Punch hygiene at the door: configurable cooldown windows and same-status rescan suppression, so a second tap in the queue can't become a second punch.",
      'CIDR-aware network validation that sorts candidate ranges by size, so overlapping IP configs resolve by specificity rather than by whichever row was inserted first.',
    ],
    stack: ['PHP 8.2', 'Laravel 12', 'Filament 4', 'Livewire', 'Tailwind CSS 4', 'Vite 7'],
  },
  {
    id: 'payroll',
    name: 'UPLB Payroll Control System',
    kind: 'Audit-first payroll',
    role: 'core contributor · holiday-pay entitlement and delivery pipeline',
    desc: "Integer-centavo computation, effective-dated authorities, segregation of duties and immutable hashed register snapshots. It is deliberately not authorized to run live payroll yet: the build names its own go-live gates (HRDO, Accounting, the resident COA auditor, BIR, the servicing bank) instead of implying sign-off it doesn't have.",
    highlights: [
      'Holiday-pay entitlement end to end: an effective-dated HolidayPayAuthority, a resolver that returns a HolidayPayVerdict value object instead of a bare boolean, contract-level wiring, Gate policies and the Filament resource around it.',
      'Owned the delivery pipeline: dev-to-main auto-merge with deployment tagging, a local git-reset deploy replacing brittle SSH updates, and deployer-safe filesystem and log permissions.',
      'Wrote the production-environment documentation the next person needs: configuration, permissions, known issues, and the COS/ICS holiday-pay rules.',
    ],
    stack: ['Laravel 13', 'Filament 5', 'PostgreSQL', 'Livewire', 'Tailwind CSS', 'GitHub Actions'],
  },
  {
    id: 'dame',
    name: 'DAME UPLB',
    kind: 'Department website and CMS',
    role: 'lead developer',
    desc: "Public website and admin CMS for UPLB's Department of Agribusiness Management and Entrepreneurship: faculty profiles, academic programs, research areas and news, on the newest stack in this portfolio.",
    highlights: [
      'Personnel module with typed roles, designations, and slug-routed public profile pages.',
      'Post and category CMS with publication statuses and soft deletes.',
      'Filament 5 admin using delegated Form, Table and Infolist schema classes; a public Blade site with Tailwind v4 design tokens.',
    ],
    stack: ['PHP 8.3', 'Laravel 13', 'Filament 5', 'Livewire 4', 'PostgreSQL', 'Tailwind CSS 4', 'Pest 4'],
  },
  {
    id: 'shared',
    name: 'UPLB HR Ecosystem',
    kind: 'Shared systems',
    role: 'core contributor · 4 shared team repos',
    desc: "The ecosystem's shared apps: the HR system of record, SALN asset-disclosure e-filing, salary-document submission and the submission portal. In these team codebases I owned specific, load-bearing layers.",
    highlights: [
      'SALN e-filing, as largest single contributor: the Kafka consumer layer with transactional staging, UUID standardization across core models, and coordinate-mapped PDF generation onto official government forms (FPDI).',
      'HR system of record: a bulk employee-number importer with selective field mapping, a composite user, personnel and appointment creation flow, and model change-detection logic.',
      'Submission portal: submission-window controls that gate user uploads behind an admin toggle, and versioned salary-document handling.',
    ],
    stack: ['Laravel 11', 'Filament 3', 'PostgreSQL', 'MariaDB', 'Kafka', 'RabbitMQ', 'FPDI/FPDF', 'Vue 3'],
  },
];

const ownership = [
  {
    title: 'I run what I ship',
    desc: 'Self-hosted CI/CD runners as systemd services, least-privilege deploy keys, setgid permission models, PHP-FPM tuning, and a full production audit: 12 findings ranked by severity, each with evidence and a fix. The pipeline and the servers under it are mine to keep healthy.',
  },
  {
    title: 'Changelogs in plain language',
    desc: "Every release ships a personnel-facing “What's New” page in the words of the people who use it. AI drafts it, a human reviews it behind an approval gate, and tests guard the pipeline. Four thousand people shouldn't have to guess what changed.",
  },
  {
    title: 'Verification over “it works”',
    desc: 'I treat “done” as a claim to test: re-check the service, diff expected against actual, and bounce the Kafka consumers so a release never serves stale code. When something breaks, it comes back to me, and it shapes the next release.',
  },
];

const experience = [
  {
    from: 'Oct 2025',
    to: 'present',
    role: 'Full-Stack Developer · Senior ICT Assistant',
    org: 'University of the Philippines Los Baños',
    note: "Building and running the university's Kafka-linked ecosystem of HR and compliance systems.",
  },
  {
    from: 'Jan 2025',
    to: 'Oct 2025',
    role: 'Full-Stack Developer · Programmer',
    org: 'University of the Philippines Los Baños',
    note: 'Primary developer of UPLB-TKS and largest single contributor to SALN e-filing.',
  },
  {
    from: 'Nov 2024',
    to: 'Jan 2025',
    role: 'Web Developer Intern',
    org: 'ChatGenie',
    note: 'Learned Rails 8, GraphQL and Vue for the developer evaluation, and shipped a reservation system and the samyang dating app on them.',
  },
  {
    from: 'Jan 2024',
    to: 'May 2024',
    role: 'Web Developer · On-the-Job Trainee',
    org: 'DILG Cluster A, Laguna',
    note: 'Built the E-Justice System for barangay case recording, rolled out across Cluster A.',
  },
];

const education = {
  from: '2020',
  to: '2024',
  degree: 'B.S. Information Technology · Web and Mobile Application Development',
  school: 'Laguna State Polytechnic University, Los Baños',
};

const aiPractices = [
  {
    title: 'Agent skill libraries',
    desc: 'Structured domain knowledge across every repo: YAML-triggered deep-dives, DRY tables cataloguing reusable traits and services, and gotcha docs. A progressive-disclosure knowledge architecture, so AI agents work accurately in each codebase.',
  },
  {
    title: 'Executable specifications',
    desc: 'Self-contained spec documents a fresh agent can run: full context payloads, per-deliverable requirements, execution checklists and bash verification scripts, with explicit “do not invent” guardrails. Prompt engineering treated as an engineering practice.',
  },
  {
    title: 'AI features in production',
    desc: 'Two human-in-the-loop pipelines shipped: an IPCR drafting flow that clusters task logs into performance functions, and an AI changelog generator behind a human-review gate. Both are guarded by tests.',
  },
  {
    title: 'Discipline that compounds',
    desc: 'Conventional commits, documented Kafka integration contracts, automated commit reports, and CI/CD on self-hosted runners. The boring parts that make AI leverage compound instead of decay.',
  },
];

const stackGroups = [
  { label: 'languages', items: ['PHP 8.2–8.4', 'Ruby 3.3', 'JavaScript / TypeScript', 'SQL'] },
  { label: 'backend', items: ['Laravel 11/12/13', 'Filament 3–5', 'Livewire 3/4', 'Ruby on Rails 8', 'REST and GraphQL APIs'] },
  { label: 'data, messaging', items: ['MySQL', 'MariaDB', 'PostgreSQL', 'Redis', 'Apache Kafka', 'RabbitMQ'] },
  { label: 'frontend', items: ['Tailwind CSS 3/4', 'Vue 2 and 3', 'Vuex', 'Apollo Client', 'Alpine.js', 'Vite', 'Blade'] },
  { label: 'quality, delivery', items: ['PHPUnit 11', 'Pest 4', 'Docker', 'GitHub Actions', 'Bitbucket', 'Jira', 'Conventional Commits'] },
  { label: 'domain depth', items: ['RBAC (Shield + Spatie)', 'Approval workflows', 'PDF generation (DomPDF/FPDI)', 'PII encryption', 'Government compliance forms'] },
];

const navLinks = [
  { href: '#work', label: 'work' },
  { href: '#experience', label: 'experience' },
  { href: '#cadence', label: 'cadence' },
];
---

<Layout
  title="Carl Janzell Oropesa — Full-Stack Software Engineer"
  description="Full-stack software engineer in Los Baños, Philippines. I build Laravel and Filament systems serving 4,000+ university personnel, wired together over Apache Kafka."
>
  <div id="top" class="wrap">
    <!-- top bar: identity typed in on first load -->
    <header class="topbar mono">
      <a href="#top" class="topbar-name"><b data-punch="type">carl janzell oropesa</b></a>
      <span class="topbar-role" data-punch="type">full-stack software engineer · los baños, ph</span>
      <nav class="topbar-nav" aria-label="Sections">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={cvHref} target="_blank" rel="noopener">résumé ↗</a>
      </nav>
    </header>

    <main>
      <!-- hero: the ecosystem is the picture -->
      <section class="hero" data-hero>
        <div class="hero-text">
          <h1>I build systems people depend on.</h1>
          <p class="hero-lede">Most of my work is the backbone of UP Los Baños' HR operations: Laravel systems that exchange data over Apache Kafka and serve 4,000+ personnel.</p>
          <div class="facts" data-facts>
            <i class="rule" data-punch="rule"></i>
            {
              facts.map((f) => (
                <p class="fact">
                  <span class="fact-v" data-punch="count">{f.value}</span>
                  <span class="fact-k" data-punch="type">{f.label}</span>
                  <i class="rule rule-b" data-punch="rule" />
                </p>
              ))
            }
            <p class="stamp-wrap">
              <span class="stamp" data-punch="stamp"><b>Verified</b> <small>22 Sep 2026</small></span>
            </p>
          </div>
          <p class="hero-cta mono">
            <a class="link" href={cvHref} target="_blank" rel="noopener">résumé.pdf</a>
            <a class="link" href={github} target="_blank" rel="noopener">github</a>
            <a class="link" href={linkedin} target="_blank" rel="noopener">linkedin</a>
            <a class="link" href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
        <EcosystemMap />
      </section>

      <!-- work -->
      <section id="work" class="section">
        <div class="sec-head">
          <h2>Work</h2>
          <p class="label">roles reflect commit ownership as of 22 Sep 2026</p>
        </div>
        <p class="sec-lede">Internal university systems doing compliance-heavy work: civil-service forms, multi-stage approval chains, audit trails and encrypted personal data. These are private government codebases, so I can't hand you a live demo. Instead, each entry gives the architecture, the decisions and, where I can measure it, the real usage.</p>
        {
          projects.map((p) => (
            <article id={p.id} class="project">
              <header class="project-head">
                <h3>
                  {p.name}{' '}<span class="project-kind">{p.kind}</span>
                </h3>
                <p class="label">{p.role}</p>
              </header>
              <div class="project-body">
                <p class="project-desc">{p.desc}</p>
                {p.spec && (
                  <dl class="spec">
                    {p.spec.map(([k, v]) => (
                      <>
                        <dt class="label">{k}</dt>
                        <dd>{v}</dd>
                      </>
                    ))}
                  </dl>
                )}
                <ul class="project-list">
                  {p.highlights.map((h) => <li>{h}</li>)}
                </ul>
                <p class="project-stack label">{p.stack.join(' · ')}</p>
              </div>
            </article>
          ))
        }
      </section>

      <!-- ownership -->
      <section id="practice" class="section practice">
        <div class="practice-lead">
          <h2>I stay with what I ship.</h2>
          <p class="practice-8am">The part that matters to me isn't the commit — it's the person clocking in at 8&nbsp;AM who needs it to just work.</p>
          <p class="sec-lede">So I deploy what I build, keep the servers under it healthy, fix it when it breaks, and write the release note the way I'd want to read it.</p>
        </div>
        <ol class="pillars">
          {
            ownership.map((item, i) => (
              <li>
                <span class="label">0{i + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <ContributionHeatmap />

      <!-- experience -->
      <section id="experience" class="section">
        <div class="sec-head">
          <h2>Experience</h2>
          <p class="label">two years from on-the-job trainee to senior ICT assistant</p>
        </div>
        <p class="sec-lede">Shipping the whole way. The <a class="link" href={cvHref} target="_blank" rel="noopener">full résumé</a> has the rest.</p>
        <ol class="record">
          {
            experience.map((job) => (
              <li>
                <span class="record-when mono">{job.from} – {job.to}</span>
                <div>
                  <h3>{job.role}</h3>
                  <p class="record-org">{job.org}</p>
                </div>
                <p class="record-note">{job.note}</p>
              </li>
            ))
          }
          <li>
            <span class="record-when mono">{education.from} – {education.to}</span>
            <div>
              <h3>{education.degree}</h3>
              <p class="record-org">{education.school}</p>
            </div>
            <p class="record-note"></p>
          </li>
        </ol>
      </section>

      <!-- ai engineering -->
      <section id="ai" class="section">
        <div class="sec-head">
          <h2>AI-native engineering</h2>
        </div>
        <p class="sec-lede">I build the infrastructure that makes AI coding tools effective. I treat agents as team members who need onboarding docs, so I write the docs.</p>
        <div class="practices">
          {
            aiPractices.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- public code and stack -->
      <section id="stack" class="section">
        <div class="sec-head">
          <h2>Public code and stack</h2>
        </div>
        <p class="sec-lede">Laravel is where I go deepest, but I'm not tied to it. Two pieces of code you can read:</p>
        <div class="public">
          <article>
            <h3>samyang</h3>
            <p class="label">ruby on rails 8 · graphql · vue 2</p>
            <p>A full dating app I built solo during ChatGenie's developer evaluation: a Ruby on Rails 8 GraphQL API and a Vue 2 + Vuex SPA with Apollo, Cloudinary uploads, swipe-and-match mechanics and an admin panel. The source is public; the demo backend is retired.</p>
            <p class="public-links mono">
              <a class="link" href="https://github.com/Darkify19/samyang-back" target="_blank" rel="noopener">samyang-back ↗</a>
              <a class="link" href="https://github.com/Darkify19/samyang-front" target="_blank" rel="noopener">samyang-front ↗</a>
            </p>
          </article>
          <article>
            <h3>filament-page-builder</h3>
            <p class="label">laravel · filament · built in public</p>
            <p>A drag-and-drop page builder for Filament with a nested layout canvas, document outline, token style inspector and undo/redo. It all persists to the same JSON column the form editor already writes, so neither surface owns the content.</p>
            <p class="public-links mono">
              <a class="link" href="https://github.com/carljanzell/filament-page-builder" target="_blank" rel="noopener">source ↗</a>
              <a class="link" href="https://carljanzell.github.io/filament-page-builder/" target="_blank" rel="noopener">docs ↗</a>
            </p>
          </article>
        </div>
        <dl class="spec stack">
          {
            stackGroups.map((g) => (
              <>
                <dt class="label">{g.label}</dt>
                <dd>{g.items.join(' · ')}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <!-- contact -->
      <section id="contact" class="section contact">
        <h2>Get in touch</h2>
        <p class="sec-lede">Open to software engineering roles where systems thinking, event-driven architecture and an AI-native workflow matter more than any single framework. Based in Los Baños, Philippines.</p>
        <p class="contact-links mono">
          <a class="link" href={`mailto:${email}`}>{email}</a>
          <a class="link" href={linkedin} target="_blank" rel="noopener">linkedin ↗</a>
          <a class="link" href={github} target="_blank" rel="noopener">github ↗</a>
          <a class="link" href={cvHref} target="_blank" rel="noopener">résumé.pdf ↗</a>
        </p>
      </section>
    </main>

    <footer class="footer label">
      <p>© 2026 Carl Janzell Oropesa · built with Astro and Tailwind CSS · deployed on GitHub Pages</p>
    </footer>
  </div>
</Layout>

<style is:global>
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (max-width: 600px) {
    .wrap {
      padding: 0 16px;
    }
  }

  /* ---------- top bar ---------- */
  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    padding: 22px 0 14px;
    border-bottom: 1px solid var(--color-rule);
    font-size: 12px;
    color: var(--color-muted);
  }
  .topbar-name {
    color: var(--color-ink);
    text-decoration: none;
  }
  .topbar-name b {
    font-weight: 500;
  }
  .topbar-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-left: auto;
  }
  .topbar-nav a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .topbar-nav a:hover {
    color: var(--color-ink);
  }
  @media (max-width: 759px) {
    .topbar-role {
      flex-basis: 100%;
    }
    .topbar-nav {
      gap: 6px 16px;
      margin-left: 0;
    }
  }

  /* ---------- hero ---------- */
  .hero {
    display: grid;
    gap: 40px;
    padding: 40px 0 64px;
  }
  .hero .eco-map {
    max-width: 820px;
  }
  @media (min-width: 1280px) {
    .hero {
      grid-template-columns: 420px minmax(0, 1fr);
      gap: 48px;
      align-items: start;
    }
    .hero .eco-map {
      max-width: none;
      margin-top: 4px;
    }
  }
  .hero h1 {
    font-size: clamp(40px, 5.4vw, 54px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.01em;
  }
  .hero-lede {
    max-width: 44ch;
    margin-top: 18px;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-soft);
  }

  .facts {
    position: relative;
    max-width: 460px;
    margin-top: 58px;
  }
  .facts .rule {
    display: block;
    height: 1px;
    background: var(--color-rule);
    transform-origin: 0 50%;
  }
  .fact {
    position: relative;
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 14px;
    align-items: baseline;
    padding: 10px 0;
  }
  .fact .rule-b {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }
  .fact-v {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 19px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .fact-k {
    font-size: 15.5px;
    line-height: 1.35;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  /* sits just above the table, its lower edge on the top rule */
  .stamp-wrap {
    position: absolute;
    right: 0;
    top: -48px;
    transform: rotate(-7deg);
    pointer-events: none;
  }
  .stamp {
    display: grid;
    justify-items: center;
    padding: 6px 13px 7px;
    border: 2px solid var(--color-signal);
    border-radius: 4px;
    outline: 1px solid var(--color-signal);
