---
import ContributionSkyline from './ui/contribution-skyline';
import contributions from '../data/contributions.json';

const days = contributions.days;
const total = contributions.total;
const activeDays = contributions.activeDays ?? days.filter((d) => d.count > 0).length;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${Number(d)} ${MONTHS[Number(m) - 1]} ${y}`;
};

const firstDate = fmt(days[0].date);
const lastDate = fmt(days[days.length - 1].date);

// The old grid's amber ramp (signal at 20/40/66/96% over graphite), flattened to
// solid colours: the skyline reads each colour as opaque RGB and shades the sides.
const amber = ['#3f3521', '#6c5629', '#a78033', '#ebb13e'];
---

<section id="cadence" class="section">
  <div class="sec-head">
    <h2>Shipping cadence</h2>
    <p class="label">{total.toLocaleString('en-US')} commits · {activeDays} active days · {firstDate} to {lastDate}</p>
  </div>
  <p class="sec-lede">Every block is a day of the last year, rebuilt from the full git history of every repository I've committed to while the UPLB HR ecosystem was built out. Commits I wrote only: merges and automated commits are left out.</p>

  <div class="cad">
    <ContributionSkyline client:visible data={days} unit="commit" palette={amber} />
  </div>
</section>

<style>
  /* the skyline reads shadcn's token names; point them at the site's palette */
  .cad {
    margin-top: 28px;
    --color-background: var(--color-graphite);
    --color-foreground: var(--color-ink);
    --color-border: var(--color-rule);
    --color-muted-foreground: var(--color-muted);
  }
</style>
